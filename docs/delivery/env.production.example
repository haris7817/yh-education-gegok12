# ============================================================================
# PRODUCTION .env TEMPLATE — YH Education (GegoK12)
# Copy to the server as `.env` and fill the < > placeholders. NO real secrets
# are stored here. Never commit the filled-in .env. Generate APP_KEY on the
# server with:  php artisan key:generate
# ============================================================================

APP_NAME="YH Education"
APP_ENV=production
APP_KEY=                      # set by `php artisan key:generate` on the server
APP_DEBUG=false
APP_URL=https://<yheduhk-domain>

LOG_CHANNEL=daily

# --- Database (local MySQL on the VPS) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yheducation
DB_USERNAME=<db_user>
DB_PASSWORD=<strong_db_password>

# --- Sessions / security (HTTPS) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true    # cookies only sent over HTTPS
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log

# --- File storage (local disk; persists on a VPS) ---
FILESYSTEM_DISK=uploads

# --- Localisation (YH Education) ---
TIMEZONE='Asia/Hong_Kong'     # the app reads TIMEZONE, not APP_TIMEZONE
CURRENCY_SYMBOL="HK$"
WHATSAPP_COUNTRY_CODE=852

# --- Mail (configure a real provider to enable notifications) ---
MAIL_MAILER=smtp
MAIL_HOST=<smtp_host>
MAIL_PORT=587
MAIL_USERNAME=<smtp_user>
MAIL_PASSWORD=<smtp_password>
MAIL_FROM_ADDRESS=<from@yourdomain>
MAIL_FROM_NAME="${APP_NAME}"
MAIL_STATUS=on                # turn login/notification emails back on in production

# --- Optional integrations (leave blank unless used) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
SMS_STATUS=off
FCM_SERVER_KEY=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=
GOOGLE_MAPS_API_KEY=
