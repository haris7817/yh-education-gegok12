# ============================================================================
# YH Education — production .env (installed by deploy-yhedu.sh; no secrets here)
# __DB_PASSWORD__ is substituted by the script with a server-generated password.
# APP_KEY is generated on the server by `php artisan key:generate`.
# When the domain + HTTPS go live, `deploy-yhedu.sh https <domain>` updates
# APP_URL and SESSION_SECURE_COOKIE automatically.
# ============================================================================

APP_NAME="YH Education"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://129.150.50.78

LOG_CHANNEL=daily

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yheducation
DB_USERNAME=yhedu
DB_PASSWORD=__DB_PASSWORD__

BROADCAST_DRIVER=log
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false   # flipped to true by the https phase
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=uploads

TIMEZONE='Asia/Hong_Kong'
CURRENCY_SYMBOL="HK$"
WHATSAPP_COUNTRY_CODE=852

# --- Mail: OFF until the client supplies SMTP. IMPORTANT: do not set
# MAIL_STATUS=on without working SMTP credentials — the app emails on every
# login and a dead SMTP turns logins into HTTP 500s.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=yh.eduhk@gmail.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_STATUS=off
REMINDER=mail

# --- Unused integrations (leave blank) ---
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
SMS_GATEWAY=MSG91
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SENDER_ID=""
SMS_GATEWAY_ROUTE_NO=4
SMS_STATUS=off
FCM_SERVER_KEY=
FCM_SENDER_ID=
FCM_TEACHER_SERVER_KEY=""
FCM_TEACHER_SENDER_ID=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
GOOGLE_RECAPTCHA_KEY=
GOOGLE_RECAPTCHA_SECRET=
GOOGLE_MAPS_API_KEY=
SCOUT_QUEUE=true
ALGOLIA_APP_ID =
ALGOLIA_SECRET =
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_KEY=
TWILIO_SECRET=
CACHE_TIME=8400
SNOOZE_TIME=600
FIREBASE_CREDENTIALS=''
TEACHER_FIREBASE_CREDENTIALS=''
ADDON_API_URL=
DEBUGBAR_ENABLED=false
