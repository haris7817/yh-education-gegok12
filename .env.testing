# ============================================================================
# TEST ENVIRONMENT — loaded automatically when APP_ENV=testing (phpunit).
# Forces an in-memory SQLite database so tests (incl. RefreshDatabase) can
# NEVER target the development/production MySQL database.
# Contains no real secrets: the APP_KEY below is a throwaway test key.
# ============================================================================

APP_NAME="YH Education (testing)"
APP_ENV=testing
APP_KEY=                 # generate locally for Feature tests: php artisan key:generate --env=testing
APP_DEBUG=true

# Isolated in-memory database — destructive tests cannot reach MySQL.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_STATUS=off
BCRYPT_ROUNDS=4

TIMEZONE='Asia/Hong_Kong'
CURRENCY_SYMBOL="HK$"
WHATSAPP_COUNTRY_CODE=852
